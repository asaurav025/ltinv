# Copy to .env (gitignored) on the machine that runs ltinv. Never commit or paste these.

# Kite Connect app (Personal plan is enough for holdings and trades).
# The app's redirect URL can be any URL you control; in Phase 0 you paste the URL
# you land on after login into `ltinv kite login`.
KITE_API_KEY=
KITE_API_SECRET=

# Phase 1+: LLM call sites (flags confirm, health monthly, review quarterly).
ANTHROPIC_API_KEY=

# Optional: where config/ and data/ live. Defaults to the current directory.
# LTINV_HOME=/opt/ltinv
